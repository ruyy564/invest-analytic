{
  "name": "invest-analytic",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Агент-аналитик портфеля Tinkoff Invest: NestJS + LangGraph + MCP",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:dev": "tsc -w -p tsconfig.build.json",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --config jest.config.cjs",
    "test:e2e": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --config jest-e2e.config.cjs --runInBand",
    "smoke:mcp": "node --env-file=.env scripts/smoke-mcp.mjs",
    "trace": "node --env-file=.env scripts/trace-report.mjs",
    "replay": "node --env-file=.env scripts/replay-run.mjs",
    "studio": "npm run build && langgraphjs dev --host 127.0.0.1 --port 2024 --no-browser",
    "studio:open": "node scripts/open-studio.mjs",
    "studio:check": "node --env-file=.env scripts/studio-check.mjs",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\""
  },
  "dependencies": {
    "@langchain/core": "^1.3.1",
    "@langchain/langgraph": "^1.5.3",
    "@langchain/langgraph-checkpoint-sqlite": "^1.1.0",
    "@langchain/mcp-adapters": "^2.0.1",
    "@langchain/openai": "^1.8.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@nestjs/common": "^12.3.2",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.3.2",
    "@nestjs/platform-express": "^12.3.2",
    "@nestjs/terminus": "^12.1.0",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^18.0.9",
    "langchain-gigachat": "^0.0.18",
    "langsmith": "^0.11.4",
    "pino": "^10.4.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@langchain/langgraph-api": "^1.5.6",
    "@langchain/langgraph-cli": "^1.5.6",
    "@nestjs/testing": "^12.3.2",
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.6",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.13.0",
    "jest": "^30.5.2",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
