# ─────────────────────────────────────────────────────────────
# Пример конфигурации. Скопируйте в .env и заполните значения.
# Список ключей синхронизирован с zod-схемой (src/config/env.schema.ts).
# ─────────────────────────────────────────────────────────────

# ── Приложение ───────────────────────────────────────────────
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
# Логировать текст вопросов пользователя (по умолчанию выключено)
LOG_QUESTION_TEXT=false
# Пространство имён глобального хранилища
USER_ID=default

# ── LLM ───────────────────────────────────────────────────────
# gigachat | openai | openai-compatible
LLM_PROVIDER=openai-compatible
LLM_MODEL=gpt-4o-mini
# Модель для классификации; если пусто — используется LLM_MODEL
LLM_ROUTER_MODEL=
LLM_TEMPERATURE=0.2
# Для openai и openai-compatible
LLM_API_KEY=
# Только для openai-compatible
LLM_BASE_URL=

# GigaChat (только при LLM_PROVIDER=gigachat)
GIGACHAT_CREDENTIALS=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_AUTH_URL=https://ngw.devices.sberbank.ru:9443/api/v2/oauth
# true — SSE-поток; false (по умолчанию) — обычный HTTP-запрос.
# С потоком GigaChat иногда отдаёт обрезанный чанк, и ответ «зависает» на минуты.
GIGACHAT_STREAMING=false

# ── MCP ───────────────────────────────────────────────────────
# Список серверов через запятую: каждое имя NAME даёт набор MCP_<NAME>_*
MCP_SERVERS=tinkoff
MCP_TINKOFF_URL=
# http | sse
MCP_TINKOFF_TRANSPORT=http
MCP_TINKOFF_TOKEN=
# strict | extra-ca | insecure. T-Invest MCP отдаёт цепочку, которой нет в системном
# хранилище: нужен extra-ca и файл, сохранённый `node scripts/fetch-mcp-ca.mjs`.
MCP_TINKOFF_TLS_MODE=
MCP_TINKOFF_CA_FILE=
# Обязательный allowlist: ТОЛЬКО read-only инструменты, полный каталог чтения.
# Счета и доступ, портфель и маржа, заявки (чтение), справочники и списки,
# карточки бумаг, рыночные данные, аналитика (прогнозы, консенсус, инсайдеры,
# сигналы и стратегии, новости, события по облигациям).
# Торговые и денежные операции запрещены: см. FORBIDDEN_TOOL_PATTERNS в src/config/env.schema.ts
MCP_TINKOFF_ALLOWED_TOOLS=invest_list_accounts,invest_list_broker_accounts,invest_get_user_info,invest_get_portfolio,invest_get_positions,invest_get_operations,invest_get_broker_account_margin,invest_get_broker_account_values,invest_get_blocked_guarantee,invest_get_orders,invest_get_order_state,invest_get_stoporders,invest_find_instrument,invest_get_asset,invest_get_brand,invest_list_assets,invest_list_brands,invest_list_countries,invest_list_currencies,invest_list_indicatives,invest_list_shares,invest_list_bonds,invest_list_etfs,invest_list_futures,invest_list_options,invest_list_dfas,invest_list_structured_notes,invest_get_share,invest_get_bond,invest_get_etf,invest_get_future,invest_get_option,invest_get_dfa,invest_get_currency,invest_get_structured_note,invest_get_candles,invest_get_last_trades,invest_get_market_values,invest_get_orderbook,invest_get_tech_analysis,invest_get_trading_schedule,invest_get_trading_statuses,invest_get_risk_rates,invest_get_asset_fundamentals,invest_get_share_dividends,invest_get_forecast,invest_list_consensus_forecasts,invest_get_insider_deals,invest_get_instrument_reports,invest_list_signals,invest_list_strategies,invest_get_news,invest_get_bond_accrued,invest_get_bond_events
# Если пусто — агент узнаёт счёт через MCP
TINKOFF_ACCOUNT_ID=

# ── Прогон и отчёт ────────────────────────────────────────────
# Лимиты прогона: разбор портфеля требует больше вызовов, чем точечный вопрос
RUN_TOOL_MAX_CALLS=200
RUN_DEADLINE_MS=240000
# Сколько вызовов инструментов выполнять одновременно
RUN_PARALLELISM=4
# Сколько бумаг портфеля разбирать расширенной аналитикой
REVIEW_MAX_INSTRUMENTS=15
# Таймаут одного вызова инструмента MCP
MCP_TOOL_TIMEOUT_MS=15000
# Шаблон отчёта: секции, пороги, периоды — правятся файлом, без правок кода
REPORT_TEMPLATE_FILE=reports/portfolio-review.yaml
# Промпт интерпретации: им модель пишет разделы «макро» и «итог»
REPORT_INTERPRETATION_PROMPT_FILE=reports/prompts/interpretation.md
# false — вернуть поведение без ветки разбора (совместимость)
REVIEW_ENABLED=true
# Справка о возможностях агента отдельной веткой графа
AGENT_HELP_ENABLED=true
# База знаний по инвестициям: каталог файлов-тем (файл = тема)
KNOWLEDGE_ENABLED=true
KNOWLEDGE_DIR=data/knowledge
# Дополнительный файл-тема поверх каталога (необязательно)
KNOWLEDGE_FILE=
# Предел объёма справочного блока в промпте, символов (не меньше 400)
KNOWLEDGE_MAX_CHARS=1800

# ── Источники данных помимо брокера ───────────────────────────
# id источников через запятую: tinkoff | cbr | interfax | rbc | smartlab | rbc_quote | tbank_research | vedomosti | kommersant | tass | finam
SOURCES=tinkoff,cbr,interfax,rbc,smartlab,smartlab_tag,rbc_quote,tbank_research,vedomosti,kommersant,tass,finam
# live — SOAP ЦБ → кэш → сид → HTML; seed — только файл; off — без ставки
KEY_RATE_SOURCE_MODE=live
KEY_RATE_SEED_FILE=data/key-rate-seed.json
KEY_RATE_SOAP_URL=https://www.cbr.ru/DailyInfoWebServ/DailyInfo.asmx
KEY_RATE_HTML_URL=https://www.cbr.ru/hd_base/KeyRate/
KEY_RATE_CACHE_TTL_HOURS=24
# Ленты новостей и мнений (RSS 2.0) и HTML-страницы брокеров, id через запятую; Telegram не используется
NEWS_SOURCES=interfax,rbc,smartlab,smartlab_tag,rbc_quote,tbank_research,vedomosti,kommersant,tass,finam
# Сколько страниц ленты сканировать при поиске новостей за период
NEWS_SCAN_PAGES=3
# Сколько новостей оставлять в сводке на период
NEWS_DIGEST_MAX_ITEMS=15
# Политика релевантности новостей: правила в YAML вместо кода источников.
# false — вернуться к прежним фильтрам (откат без пересборки).
NEWS_POLICY_V2=true
NEWS_POLICY_FILE=data/policy/news.yaml
NEWS_FEED_ENABLED=true
NEWS_FEED_PERIODS=1,7
NEWS_FEED_MAX_PER_PERIOD=8
# Словарь налоговых терминов для market__tax_watch
TAX_KEYWORDS_FILE=data/tax-keywords.yaml
TICKER_ALIASES_FILE=data/ticker-aliases.yaml
# Драйверы секторов и профили компаний (экспортёр / внутренний рынок)
COMPANY_PROFILES_FILE=data/company-profiles.yaml

# ── Состояние и подтверждения ─────────────────────────────────
# sqlite | memory
STATE_BACKEND=sqlite
STATE_SQLITE_PATH=./.state/state.sqlite
STATE_TTL_DAYS=30
# Журнал прогонов: JSONL, по файлу на прогон (runId).
STATE_RUNS_DIR=./.state/runs
APPROVAL_TTL_MINUTES=15
# require | allow — политика для действий без правила
APPROVAL_UNLISTED=require
# Опционально: JSON-файл, полностью заменяющий встроенные правила подтверждений
APPROVALS_FILE=

# ── Наблюдаемость ─────────────────────────────────────────────
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=invest-analytic
LANGSMITH_ORG_ID=
LANGSMITH_HIDE_INPUTS=false
LANGSMITH_TRACE_URL_TEMPLATE=https://smith.langchain.com/o/{orgId}/projects/p/{project}/r/{runId}
